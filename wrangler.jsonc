{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aozora-reader",
  "compatibility_date": "2026-07-19",
  "main": "./worker/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/",
      "/daily",
      "/shelf",
      "/words",
      "/articles",
      "/learn",
      "/topics",
      "/topics/giving-receiving",
      "/read/*",
      "/review",
      "/record",
      "/feedback",
      "/admin"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aozora-reader-db",
      "database_id": "30285486-b380-401d-8b93-0c26ad8dc1d4",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BDJABZEdcNXyrIxaylt8TZ4HByyErwAFytW50tipmr50JP2gApbMZz9Iggacwf3L0JD-L2pngnzpB0CI9QQ3glc"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4a45f627276c44738792e203d4ff14b7"
    }
  ]
}
